{
  "name": "catering-service",
  "version": "1.0.0",
  "description": "Full-stack catering service management application",
  "main": "index.js",
  "scripts": {
    "install-all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd backend && npm run dev",
    "client": "cd frontend && npm run dev",
    "lint": "npm --prefix frontend run lint",
    "build": "npm run lint && npm --prefix backend run build && npm --prefix frontend run build"
  },
  "keywords": [
    "catering",
    "service",
    "categories"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.1"
  }
}
